# kbcf-clipper — copy to .env (setup.sh does this for you). The CLI auto-loads it.
# Real shell environment variables take precedence over this file.

# Claude moment scoring (text-only payload). Get a key:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — speaker diarization in WhisperX (pyannote). Without it the
# pipeline still runs; captions just won't carry speaker labels.
#   https://huggingface.co/settings/tokens   (accept the pyannote model terms)
HF_TOKEN=
