# Copy to .env.local for local dev, and set these in Vercel for deploys.
# The site renders from seeded content until these are configured — nothing
# here is required to preview the build.

# Public site URL (metadata, canonical, sitemap, OG, JSON-LD). Set to the real
# domain in production, e.g. https://kingdombuilderscf.org. On Vercel previews
# it may be left empty — the deployment URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Analytics (optional). Plausible loads only when the domain is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Search Console verification meta tag content (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Sanity CMS (enables /studio + live content) ---
# Create a free project at sanity.io or run: npx sanity init
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Shared secret for the Sanity publish webhook → POST /api/revalidate
# (header x-revalidate-secret). Any long random string; edits go live in seconds.
SANITY_REVALIDATE_SECRET=

# --- Staff notifications for the connect/volunteer forms (optional) ---
# Notifies STAFF only. Never emails the visitor. Uses Resend if both are set.
STAFF_EMAIL=
STAFF_FROM_EMAIL=
RESEND_API_KEY=

# --- Mailing list (NOT wired until approved) ---
# Placeholder for when Mailchimp/ConvertKit is connected.
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
