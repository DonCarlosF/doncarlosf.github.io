# Copy to .env.local for local dev, and set these in Vercel for deploys.
# The site renders from seeded content until these are configured — nothing
# here is required to preview the build.

# Public site URL (used for metadata, sitemap, canonical, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://staging.kingdombuilders.example

# --- Sanity CMS (enables /studio + live content) ---
# Create a free project at sanity.io or run: npx sanity init
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Planning Center (events + groups) ---
# Create a Personal Access Token: https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=
PCO_SECRET=

# --- Staff notifications for the connect/contact form (optional) ---
# Notifies STAFF only. Never emails the visitor. Uses Resend if both are set.
STAFF_EMAIL=
STAFF_FROM_EMAIL=
RESEND_API_KEY=

# --- Mailing list (NOT wired until approved) ---
# Placeholder for when Mailchimp/ConvertKit is connected.
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
